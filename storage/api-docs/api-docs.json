{
    "openapi": "3.0.0",
    "info": {
        "title": "Staging Superapp API",
        "description": "API Documentation for Staging Superapp",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "API Server"
        }
    ],
    "paths": {
        "/api/v1/auth/authorize": {
            "get": {
                "tags": [
                    "Auth (Global)"
                ],
                "summary": "Authorize OAuth",
                "description": "Redirect to the marketplace OAuth page",
                "operationId": "authorizeMarketplace",
                "parameters": [
                    {
                        "name": "marketplace",
                        "in": "query",
                        "description": "tiktok|shopee|tokopedia|lazada",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "redirect_uri",
                        "in": "query",
                        "description": "Callback URL",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirects to authorization URL"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/auth/callback": {
            "post": {
                "tags": [
                    "Auth (Global)"
                ],
                "summary": "OAuth Callback",
                "description": "Exchange auth_code for access_token",
                "operationId": "authCallback",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "marketplace": {
                                        "type": "string",
                                        "example": "tiktok"
                                    },
                                    "code": {
                                        "type": "string",
                                        "example": "<auth_code>"
                                    },
                                    "state": {
                                        "type": "string",
                                        "example": "<state>",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successfully authenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/auth/refresh": {
            "post": {
                "tags": [
                    "Auth (Global)"
                ],
                "summary": "Refresh Token",
                "description": "Refresh access token",
                "operationId": "refreshToken",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "marketplace": {
                                        "type": "string",
                                        "example": "tiktok"
                                    },
                                    "shop_id": {
                                        "type": "string",
                                        "example": "12345678"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token refreshed successfully"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/auth/revoke": {
            "post": {
                "tags": [
                    "Auth (Global)"
                ],
                "summary": "Revoke Token",
                "description": "Cabut otorisasi toko",
                "operationId": "revokeToken",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "marketplace": {
                                        "type": "string",
                                        "example": "tiktok"
                                    },
                                    "shop_id": {
                                        "type": "string",
                                        "example": "12345678"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token revoked successfully"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/auth/shops": {
            "get": {
                "tags": [
                    "Auth (Global)"
                ],
                "summary": "List Authorized Shops",
                "description": "Daftar semua toko yang sudah terotorisasi",
                "operationId": "listAuthorizedShops",
                "parameters": [
                    {
                        "name": "marketplace",
                        "in": "query",
                        "description": "Filter by marketplace (opsional)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/{marketplace}/orders": {
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "Get orders from a specific marketplace",
                "description": "Returns list of orders for the specified marketplace (e.g., tiktok, shopee, tokopedia) after syncing from the marketplace.",
                "operationId": "getMarketplaceOrder",
                "parameters": [
                    {
                        "name": "marketplace",
                        "in": "path",
                        "description": "Marketplace name",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "marketplace": {
                                            "type": "string",
                                            "example": "tiktok"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/{marketplace}/orders/{order_id}": {
