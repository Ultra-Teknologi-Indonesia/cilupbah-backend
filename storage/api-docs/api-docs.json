    "components": {
        "schemas": {
            "Order": {
                "title": "Order Schema",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "salesorder_no": {
                        "type": "string",
                        "example": "SO-12345"
                    },
                    "channel_shop_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "customer_name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "transaction_date": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-06-04T12:00:00Z"
                    },
                    "sub_total": {
                        "type": "number",
                        "format": "float",
                        "example": 100
                    },
                    "total_disc": {
                        "type": "number",
                        "format": "float",
                        "example": 10
                    },
                    "total_tax": {
                        "type": "number",
                        "format": "float",
                        "example": 5
                    },
                    "shipping_cost": {
                        "type": "number",
                        "format": "float",
                        "example": 15
                    },
                    "insurance_cost": {
                        "type": "number",
                        "format": "float",
                        "example": 2
                    },
                    "grand_total": {
                        "type": "number",
                        "format": "float",
                        "example": 112
                    },
                    "shipping_full_name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "shipping_phone": {
                        "type": "string",
                        "example": "+6281234567890"
                    },
                    "shipping_address": {
                        "type": "string",
                        "example": "Jl. Sudirman No. 1"
                    },
                    "shipping_area": {
                        "type": "string",
                        "example": "Kebayoran Baru"
                    },
                    "shipping_city": {
                        "type": "string",
                        "example": "Jakarta Selatan"
                    },
                    "shipping_province": {
                        "type": "string",
                        "example": "DKI Jakarta"
                    },
                    "shipping_post_code": {
                        "type": "string",
                        "example": "12190"
                    },
                    "shipping_country": {
                        "type": "string",
                        "example": "Indonesia"
                    },
                    "status": {
                        "type": "string",
                        "example": "pending"
                    },
                    "is_paid": {
                        "type": "boolean",
                        "example": false
                    },
                    "is_canceled": {
                        "type": "boolean",
                        "example": false
                    },
                    "cancel_reason": {
                        "type": "string",
                        "example": null
                    },
                    "channel_status": {
                        "type": "string",
                        "example": "new"
                    },
                    "payment_method": {
                        "type": "string",
                        "example": "bank_transfer"
                    },
                    "source": {
                        "type": "string",
                        "example": "api"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-06-04T12:00:00Z"
                    },
                    "updated_at": {
