        "/api/v1/media/upload": {
            "post": {
                "tags": [
                    "Media"
                ],
                "summary": "Upload media",
                "description": "Endpoint khusus upload media yang kemudian diambil nama/id untuk dimasukan ke json.",
                "operationId": "618c10a7946639300dadb75e6fe01a0e",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "file": {
                                        "description": "File media (jpeg, png, jpg, gif, mp4, mov) max 20MB",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Media uploaded successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Media uploaded successfully"
                                        },
                                        "data": {
                                            "properties": {
                                                "media_id": {
                                                    "type": "string",
                                                    "example": "id-media_123.jpg"
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "media_123.jpg"
                                                },
                                                "url": {
                                                    "type": "string",
                                                    "example": "http://localhost/storage/media/media_123.jpg"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    }
                }
            }
        }
