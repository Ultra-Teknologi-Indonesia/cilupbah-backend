{
    "openapi": "3.0.0",
    "info": {
        "title": "Staging Superapp API",
        "description": "L5 Swagger OpenApi description",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Demo API Server (Docker)"
        }
