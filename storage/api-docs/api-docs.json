    "components": {
        "schemas": {
            "CreateProductRequest": {
                "required": [
                    "category_id",
                    "name",
                    "variants"
                ],
                "properties": {
                    "brand_id": {
                        "type": "integer",
                        "example": 101,
                        "nullable": true
                    },
                    "category_id": {
                        "type": "integer",
                        "example": 54
                    },
                    "name": {
                        "type": "string",
                        "example": "Sony Alpha A6000 Kit 16-50mm"
                    },
                    "sku": {
                        "type": "string",
                        "example": "SONY-A6000-COPY-1234",
                        "nullable": true
                    },
                    "description": {
                        "type": "string",
                        "example": "Kamera mirrorless ringan dengan sensor 24.3MP",
                        "nullable": true
                    },
                    "search_keyword": {
                        "type": "string",
                        "example": "kamera sony, alpha, a6000, mirrorless",
                        "nullable": true
                    },
                    "order_type": {
                        "type": "string",
                        "example": "PREORDER",
                        "nullable": true,
                        "enum": [
                            "REGULER",
                            "PREORDER",
                            "COD"
                        ]
                    },
                    "indent_days": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "weight": {
                        "type": "number",
                        "format": "float",
                        "example": 1.5,
                        "nullable": true
                    },
                    "length": {
                        "type": "number",
                        "format": "float",
                        "example": 12,
                        "nullable": true
                    },
                    "width": {
                        "type": "number",
                        "format": "float",
                        "example": 10,
                        "nullable": true
                    },
                    "height": {
                        "type": "number",
                        "format": "float",
                        "example": 4,
                        "nullable": true
                    },
                    "condition": {
                        "type": "string",
                        "example": "NEW",
                        "nullable": true,
                        "enum": [
                            "NEW",
                            "USED"
                        ]
                    },
                    "is_cod_allowed": {
                        "type": "boolean",
                        "example": false,
                        "nullable": true
                    },
                    "danger_level": {
                        "type": "integer",
                        "example": 0,
                        "nullable": true
                    },
                    "is_draft": {
                        "type": "boolean",
                        "example": false,
                        "nullable": true
                    },
                    "showcase_id": {
                        "type": "integer",
                        "example": null,
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true,
                        "nullable": true
                    },
                    "specifications": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "attribute_id": {
                                    "type": "integer",
                                    "example": 36
                                },
                                "attribute_option_id": {
                                    "type": "integer",
                                    "example": null,
                                    "nullable": true
                                },
                                "text_value": {
                                    "type": "string",
                                    "example": "24.3 MP",
                                    "nullable": true
                                }
                            },
                            "type": "object"
                        },
                        "nullable": true
                    },
                    "media": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "url": {
                                    "type": "string",
                                    "example": "https://example.com/image1.jpg"
                                },
                                "media_type": {
                                    "type": "string",
                                    "example": "image",
                                    "nullable": true,
                                    "enum": [
                                        "image",
                                        "video"
                                    ]
                                },
                                "is_primary": {
                                    "type": "boolean",
                                    "example": true,
                                    "nullable": true
                                },
                                "sort_order": {
                                    "type": "integer",
                                    "example": 1,
                                    "nullable": true
                                }
                            },
                            "type": "object"
                        },
                        "nullable": true
                    },
                    "variation_types": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "attribute_id": {
                                    "type": "integer",
                                    "example": 1
                                },
                                "sort_order": {
                                    "type": "integer",
                                    "example": 1,
                                    "nullable": true
                                }
                            },
                            "type": "object"
                        },
                        "nullable": true
                    },
                    "variants": {
                        "type": "array",
                        "items": {
                            "required": [
                                "sku",
                                "sell_price"
                            ],
                            "properties": {
                                "sku": {
                                    "type": "string",
                                    "example": "SONY-A6000-BLACK-L-1234"
                                },
                                "barcode": {
                                    "type": "string",
                                    "example": "899123456789",
                                    "nullable": true
                                },
                                "buy_price": {
                                    "type": "number",
                                    "format": "float",
                                    "example": 5000000,
                                    "nullable": true
                                },
                                "sell_price": {
                                    "type": "number",
                                    "format": "float",
                                    "example": 6000000
                                },
                                "weight": {
                                    "type": "number",
                                    "format": "float",
                                    "example": 1.2,
                                    "nullable": true
                                },
                                "length": {
                                    "type": "number",
