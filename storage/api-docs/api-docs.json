                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/media/upload": {
            "post": {
                "tags": [
                    "Media"
                ],
                "summary": "Upload a media file (image/video)",
                "description": "Uploads an image or video file and returns its public URL.",
                "operationId": "uploadMedia",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "file"
                                ],
                                "properties": {
                                    "file": {
                                        "description": "The media file to upload (image or video)",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "File uploaded successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "url": {
                                            "type": "string",
                                            "example": "http://localhost:8000/storage/uploads/filename.jpg"
                                        },
                                        "filename": {
                                            "type": "string",
                                            "example": "filename.jpg"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation failed or no file provided"
                    }
                }
            }
        },
        "/api/v1/{marketplace}/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Get products from a specific marketplace",
                "description": "Returns list of products for the specified marketplace (e.g., tiktok, shopee, tokopedia) after syncing from the marketplace.",
                "operationId": "getMarketplaceProduct",
                "parameters": [
                    {
                        "name": "marketplace",
                        "in": "path",
                        "description": "Marketplace name",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "marketplace": {
                                            "type": "string",
                                            "example": "tiktok"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Products"
                ],
                "summary": "Upload / Create product for a specific marketplace",
                "description": "Creates a product locally and prepares it for syncing with the specified marketplace.",
                "operationId": "storeMarketplaceProduct",
                "parameters": [
                    {
                        "name": "marketplace",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateProductRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Product created successfully"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
