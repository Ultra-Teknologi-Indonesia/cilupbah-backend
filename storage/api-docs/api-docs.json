    "paths": {
        "/api/v1/{marketplace}/products": {
            "get": {
                "tags": [
                    "Marketplace Products"
                ],
                "summary": "List products",
                "description": "List produk (paginated) untuk marketplace tertentu.",
                "operationId": "f94cd2082d6960fdd41c3913e8bbc1de",
                "parameters": [
                    {
                        "name": "marketplace",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "filter[is_active]",
                        "in": "query",
                        "description": "Filter aktif/tidak aktif (true/false/1/0)",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "filter[name]",
                        "in": "query",
                        "description": "Cari berdasarkan nama produk",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort field (e.g. name, -created_at, sell_price)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Get products success"
                    }
                }
            },
            "post": {
                "tags": [
                    "Marketplace Products"
                ],
                "summary": "Create product",
                "description": "Buat produk baru secara lokal dan push ke marketplace. Body payload harus menyertakan shop_id dan struktur lengkap (variants, media, dll).",
                "operationId": "ae9bb5e6935b8ecd5fd114f557ce1384",
                "parameters": [
                    {
                        "name": "marketplace",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object"
                            },
                            "example": {
                                "shop_id": "7494685794425930858",
                                "brand_id": 1,
                                "category_id": 1,
                                "name": "Sepatu Bola Nike Mercurial Superfly",
                                "sku": "SHOE-FB-NIKE-001",
                                "description": "Sepatu bola premium dengan teknologi flyknit yang ringan dan nyaman.",
                                "search_keyword": "sepatu bola, nike mercurial",
                                "order_type": "REGULER",
                                "indent_days": 0,
                                "weight": 0.8,
                                "length": 30,
                                "width": 15,
                                "height": 12,
                                "condition": "NEW",
                                "is_cod_allowed": true,
                                "danger_level": 0,
                                "is_draft": false,
                                "showcase_id": null,
                                "is_active": true,
                                "specifications": [
                                    {
                                        "attribute_id": 1,
                                        "attribute_option_id": null,
                                        "text_value": "Sintetis Premium"
                                    }
                                ],
                                "media": [
                                    {
                                        "url": "https://example.com/sepatu-bola.jpg",
                                        "media_type": "image",
                                        "is_primary": true,
                                        "sort_order": 1
                                    }
                                ],
                                "variation_types": [
                                    {
                                        "attribute_id": 1,
                                        "sort_order": 1
                                    },
                                    {
                                        "attribute_id": 2,
                                        "sort_order": 2
                                    }
                                ],
                                "variants": [
                                    {
                                        "sku": "SHOE-FB-NIKE-001-RED-42",
                                        "buy_price": 1200000,
                                        "sell_price": 1500000,
                                        "weight": 0.8,
                                        "length": 30,
                                        "width": 15,
                                        "height": 12,
                                        "is_serial_batch": false,
                                        "is_active": true,
                                        "options": [
                                            {
                                                "attribute_id": 1,
                                                "value": "Red"
                                            },
                                            {
                                                "attribute_id": 2,
                                                "value": "42"
                                            }
                                        ],
                                        "media": [
                                            {
                                                "url": "https://example.com/sepatu-bola-red.jpg",
                                                "media_type": "image",
                                                "is_primary": true,
                                                "sort_order": 1
                                            }
                                        ],
                                        "wholesale_prices": [
                                            {
                                                "min_qty": 5,
                                                "price": 1400000,
                                                "customer_type": "B2B"
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Product created and pushed to marketplace"
                    }
                }
            }
        },
