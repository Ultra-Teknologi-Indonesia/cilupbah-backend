APP_NAME=Cilupbah
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_BUSINESS_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cilupbah
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=redis
DATABASE_UNAVAILABLE_RETRY_AFTER=10

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

QUEUE_CONNECTION=redis
QUEUE_LABEL_CONNECTION=redis-long
QUEUE_LABEL_PARALLELISM=2
QUEUE_LABEL_RATE_LIMIT_ATTEMPTS=5
QUEUE_LABEL_RATE_LIMIT_DECAY_SECONDS=1
QUEUE_QR_LABELS_CONNECTION=redis-long
QUEUE_NAME_QR_LABELS=qr-labels
QUEUE_QR_LABELS_MEMORY_LIMIT=512M
QUEUE_NAME_TRACKING=tracking
QUEUE_NAME_IMPORTS=product
QUEUE_NAME_SALES=orders

# Picklist PDF: foto selalu dipertahankan; worker membuat thumbnail lokal
# agar ukuran gambar dan penggunaan memory tetap terkendali.

# Channel sync resilience
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MINUTES=5
CHANNEL_API_RATE_LIMIT_PER_SECOND=8
CHANNEL_SEARCH_REMOTE_TIMEOUT_SECONDS=10
CHANNEL_SEARCH_REMOTE_ATTEMPTS=2

# Keep false while Jubelio and Cilupbah run in parallel. Physical stock
# backfill from channel SHIPPED/DELIVERED events must be explicitly enabled
# only after fulfillment ownership has been cut over.
INVENTORY_CHANNEL_AUTO_PHYSICAL_BACKFILL=true

# Horizon monitoring notifications
HORIZON_SLACK_WEBHOOK=
HORIZON_SLACK_CHANNEL=
HORIZON_MAIL_TO=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# TikTok Shop
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=

# Lazada Open Platform
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URI=
LAZADA_AUTH_URL=https://auth.lazada.com/oauth/authorize
LAZADA_BASE_URL=https://api.lazada.co.id/rest

# Shopee Open Platform
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_PUSH_PARTNER_KEY=
SHOPEE_REDIRECT_URI=
SHOPEE_PUSH_URL=
SHOPEE_HOST=https://partner.shopeemobile.com

# Object storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_DISK=local

# Sentry (kosongkan untuk menonaktifkan; isi di staging/production)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
