APP_NAME=Cilupbah
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_BUSINESS_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cilupbah
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
IMPORT_FILE_RETENTION_HOURS=168
EXPORT_FILE_RETENTION_HOURS=168
FAILED_JOBS_RETENTION_HOURS=336
NOTIFICATION_RETENTION_HOURS=2160
WEBHOOK_COMPLETED_RETENTION_HOURS=720
OPERATIONAL_RETENTION_BATCH_SIZE=500
OPERATIONAL_RETENTION_MAX_ROWS_PER_RESOURCE=10000
CACHE_STORE=redis
DATABASE_UNAVAILABLE_RETRY_AFTER=10

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_QUEUE_HOST=127.0.0.1
REDIS_CACHE_HOST=127.0.0.1
REDIS_LONG_HOST=127.0.0.1
REDIS_LONG_CONNECTION=long
REDIS_LONG_QUEUE_RETRY_AFTER=2160
REDIS_FINANCE_HOST=127.0.0.1
REDIS_FINANCE_CONNECTION=finance
REDIS_FINANCE_DB=0
REDIS_HORIZON_HOST=127.0.0.1
REDIS_HORIZON_DB=0
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# Authenticated SSE progress streams for bulk labels and exports.
REALTIME_SSE_ENABLED=true
REALTIME_REDIS_CONNECTION=default
REALTIME_STREAM_PREFIX=realtime:user
REALTIME_STREAM_MAX_LENGTH=1000
REALTIME_STREAM_MAX_SECONDS=20
REALTIME_HEARTBEAT_SECONDS=8
REALTIME_READ_BLOCK_MS=4000
REALTIME_MAX_EVENTS_PER_READ=50
REALTIME_MAX_ACTIVE_CONNECTIONS=3
REALTIME_ACTIVE_LEASE_TTL_SECONDS=30
REALTIME_ACTIVE_CONNECTIONS_KEY=realtime:sse:active

QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=horizon
QUEUE_CHANNEL_SYNC_CONNECTION=redis-channel-sync
REDIS_CHANNEL_SYNC_RETRY_AFTER=360
CHANNEL_SYNC_WINDOW_MINUTES=5
CHANNEL_SYNC_MAX_ATTEMPTS=8
# New channel orders before this WIB cutoff are ignored; existing orders still receive status updates.
CHANNEL_ORDER_INTAKE_CUTOFF_AT=2026-09-16T16:00:00+07:00
QUEUE_NAME_SHOPEE_TRACKING_EVENTS=shopee-tracking-events
QUEUE_CHANNEL_FINANCE_CONNECTION=redis-finance
REDIS_FINANCE_QUEUE=channel-finance
REDIS_FINANCE_QUEUE_RETRY_AFTER=240
HORIZON_REDIS_CONNECTION=horizon
# Production runs two disjoint Horizon profiles: critical and background.
# Leave as all for local development unless a profile is being tested.
HORIZON_PROFILE=all
HORIZON_ORDERS_PROCESSES=3
HORIZON_FULFILLMENT_PROCESSES=2
HORIZON_STOCK_SYNC_PROCESSES=1
HORIZON_STOCK_MAX_PROCESSES=4
HORIZON_CHANNEL_CANCELLATION_PROCESSES=2
REDIS_QUEUE_RETRY_AFTER=660
QUEUE_BACKPRESSURE_ENABLED=true
CHANNEL_SYNC_MAX_QUEUE_DEPTH=24
CHANNEL_SYNC_MAX_REDIS_MEMORY_RATIO=0.70
WEBHOOK_INGRESS_MAX_QUEUE_DEPTH=1000
WEBHOOK_INGRESS_MAX_REDIS_MEMORY_RATIO=0.70
WEBHOOK_REPLAY_MAX_QUEUE_DEPTH=500
QUEUE_HEALTH_OLDEST_WARNING_SECONDS=300
QUEUE_HEALTH_OLDEST_CRITICAL_SECONDS=900
QUEUE_HEALTH_STALE_WEBHOOK_WARNING=100
QUEUE_HEALTH_FAILED_JOBS_WINDOW_MINUTES=15
QUEUE_HEALTH_FAILED_JOBS_WARNING=10
QUEUE_HEALTH_FAILED_JOBS_CRITICAL=50
FINANCE_SYNC_MAX_QUEUE_DEPTH=5000
FINANCE_SYNC_MAX_REDIS_MEMORY_RATIO=0.80
FINANCE_SYNC_EMPTY_RESPONSE_RETRY_MINUTES=360
FINANCE_SYNC_INCOMPLETE_ITEMS_RETRY_MINUTES=15
FINANCE_SYNC_BACKPRESSURE_RETRY_MINUTES=5
FINANCE_SYNC_DISPATCH_BATCH_SIZE=100
QUEUE_LABEL_CONNECTION=redis-long
QUEUE_LABEL_PARALLELISM=6
QUEUE_LABEL_PREFETCH_PARALLELISM=1
QUEUE_LABEL_RATE_LIMIT_ATTEMPTS=5
QUEUE_LABEL_RATE_LIMIT_DECAY_SECONDS=1
# Enable only with a shared durable volume mounted by both API and Horizon.
LABEL_LOCAL_FIRST=true
LABEL_PRINT_SPOOL_ROOT=/var/www/html/storage/app/print-spool
LABEL_PRINT_SPOOL_DISK=print_spool
LABEL_PRINT_ARCHIVE_DISK=documents
QUEUE_LABEL_AWB_CONNECTION=redis-long
QUEUE_NAME_LABEL_AWB=label-awb
QUEUE_LABEL_AWB_PARALLELISM=2
QUEUE_LABEL_ARCHIVE_CONNECTION=redis-long
QUEUE_NAME_LABEL_ARCHIVE=label-archive
QUEUE_LABEL_ARCHIVE_PARALLELISM=2
QUEUE_LABEL_ARCHIVE_TIMEOUT=300
QUEUE_LABEL_ARCHIVE_TRIES=5
QUEUE_QR_LABELS_CONNECTION=redis-long
QUEUE_NAME_QR_LABELS=qr-labels
QUEUE_QR_LABELS_MEMORY_LIMIT=512M
QUEUE_NAME_TRACKING=tracking
IMPORT_QUEUE_CONNECTION=redis-long
QUEUE_NAME_IMPORTS=imports
IMPORT_MEMORY_LIMIT=1024M
IMPORT_TIMEOUT=1800
EXPORT_QUEUE_CONNECTION=redis-long
EXPORT_PDF_QUEUE_CONNECTION=redis-long
EXPORT_SHEET_QUEUE_CONNECTION=redis-long
QUEUE_NAME_EXPORTS_PDF=exports-pdf
QUEUE_NAME_EXPORTS_SHEET=exports-sheet
CATALOG_EXPORT_QUEUE_CONNECTION=redis-long
QUEUE_NAME_CATALOG_EXPORTS=catalog-exports
EXPORT_PDF_MEMORY_LIMIT=1536M
EXPORT_SHEET_MEMORY_LIMIT=768M
CATALOG_EXPORT_MEMORY_LIMIT=512M
QUEUE_NAME_SALES=orders

# Picklist PDF: foto selalu dipertahankan; worker membuat thumbnail lokal
# agar ukuran gambar dan penggunaan memory tetap terkendali.

# Channel sync resilience
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MINUTES=5
CHANNEL_API_RATE_LIMIT_PER_SECOND=8
RATE_LIMIT_LAZADA_API_PER_SECOND=1
RATE_LIMIT_SHOPEE_API_PER_SECOND=4
RATE_LIMIT_TIKTOK_API_PER_SECOND=4
RATE_LIMIT_WOOCOMMERCE_API_PER_SECOND=2
RATE_LIMIT_LAZADA_API_WINDOW_SECONDS=2
CHANNEL_SEARCH_REMOTE_TIMEOUT_SECONDS=10
CHANNEL_SEARCH_REMOTE_ATTEMPTS=2

# Keep false while Jubelio and Cilupbah run in parallel. Physical stock
# backfill from channel SHIPPED/DELIVERED events must be explicitly enabled
# only after fulfillment ownership has been cut over.
INVENTORY_CHANNEL_AUTO_PHYSICAL_BACKFILL=false

# Horizon monitoring notifications
HORIZON_SLACK_WEBHOOK=
HORIZON_SLACK_CHANNEL=
HORIZON_MAIL_TO=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# TikTok Shop
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=

# Lazada Open Platform
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URI=
LAZADA_AUTH_URL=https://auth.lazada.com/oauth/authorize
LAZADA_BASE_URL=https://api.lazada.co.id/rest

# Shopee Open Platform
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_PUSH_PARTNER_KEY=
SHOPEE_REDIRECT_URI=
SHOPEE_PUSH_URL=
SHOPEE_HOST=https://partner.shopeemobile.com

# Object storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stock cutover files and reports are private objects on the configured S3/R2 disk.
STOCK_CUTOVER_CONSOLE_DISK=s3
STOCK_CUTOVER_CONSOLE_REPORT_DISK=s3
MEDIA_DISK=local

# Sentry (kosongkan untuk menonaktifkan; isi di staging/production)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
